<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="380dp"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvBookmarksHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/bookmarks_title"
            android:textColor="@color/accent_cyan"
            android:textSize="@dimen/text_header" />

        <ImageButton
            android:id="@+id/btnCloseBookmarks"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />

    </RelativeLayout>

    <!-- Pre-populated Quick Shortcuts Row -->
    <LinearLayout
        android:id="@+id/quickShortcutsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShortcutDuck"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quick_shortcut"
            android:text="DuckDuckGo"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btnShortcutMaps"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quick_shortcut"
            android:text="Google Maps"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btnShortcutYouTube"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quick_shortcut"
            android:text="YouTube"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small" />

        <Button
            android:id="@+id/btnShortcutWiki"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_quick_shortcut"
            android:text="Wikipedia"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_color" />

    <!-- Saved Bookmarks List -->
    <ListView
        android:id="@+id/lvBookmarks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider_color"
        android:dividerHeight="1dp"
        android:fadingEdge="none"
        android:listSelector="@drawable/bg_button" />

    <TextView
        android:id="@+id/tvEmptyBookmarks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/bookmarks_empty"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_regular"
        android:visibility="gone" />

</LinearLayout>
