<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="560dp"
    android:layout_height="400dp"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/history_title"
                android:textColor="@color/accent_cyan"
                android:textSize="@dimen/text_header" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_badge"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_button"
            android:contentDescription="@string/action_cancel"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary" />

    </RelativeLayout>

    <!-- Top Action Row: Manual Purge Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearAllData"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_button"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_clear_all"
            android:textAllCaps="false"
            android:textColor="@color/accent_red"
            android:textSize="@dimen/text_regular"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider_color" />

    <!-- History List -->
    <ListView
        android:id="@+id/lvHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider_color"
        android:dividerHeight="1dp"
        android:fadingEdge="none"
        android:listSelector="@drawable/bg_button" />

    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/history_empty"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_regular"
        android:visibility="gone" />

</LinearLayout>
